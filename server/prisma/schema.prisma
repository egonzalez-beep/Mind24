generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  master_admin
  empresa_admin
  candidato
}

enum AssignmentStatus {
  pending
  in_progress
  completed
  /// Asignación sustituida por una evaluación nueva del mismo candidato (no visible en lobby).
  archived
}

enum AttemptStatus {
  in_progress
  submitted
  expired
}

/// Tipos de ítem del motor dinámico de evaluaciones.
enum QuestionType {
  MULTIPLE_CHOICE
  CLEAVER_MATRIX
  AUDIO_RECORDING
  OPEN_TEXT
}

/// Used by connect-pg-simple (Express sessions)
model Session {
  sid    String   @id @db.VarChar(255)
  sess   Json
  expire DateTime @db.Timestamptz(6)

  @@map("session")
}

model Organization {
  id                     String   @id @default(cuid())
  name                   String
  slug                   String?  @unique
  blocked                Boolean  @default(false)
  credits                Int      @default(0)
  /// Solo true si el admin general dio de alta la empresa; sin esto no pueden entrar empresa ni candidatos.
  empresaPortalEnabled   Boolean  @default(false)
  createdAt              DateTime @default(now())
  updatedAt              DateTime @updatedAt

  users                 User[]
  candidates            Candidate[]
  assessmentDefinitions AssessmentDefinition[]
  workforceEmployees    WorkforceEmployee[]
  workforceTasks        WorkforceTask[]
  workforceDocuments    WorkforceDocument[]
  orgNotifications      OrgNotification[]
  recruitmentCandidates RecruitmentCandidate[]
  recruitmentVacancies  RecruitmentVacancy[]
  recruitmentStages     RecruitmentStage[]
  recruitmentApplications RecruitmentApplication[]
  recruitmentVacancyAssignees RecruitmentVacancyAssignee[]
  recruitmentApplicationStageEvents RecruitmentApplicationStageEvent[]
  recruitmentApplicationInterviewEvents RecruitmentApplicationInterviewEvent[]
  recruitmentVacancyDocuments RecruitmentVacancyDocument[]
  recruitmentVacancyStages RecruitmentVacancyStage[]
  recruitmentCandidateResumes RecruitmentCandidateResume[]
  recruitmentCandidateNotes RecruitmentCandidateNote[]
  recruitmentVacancyNotes RecruitmentVacancyNote[]
  recruitmentCandidateTags RecruitmentCandidateTag[]
  recruitmentCandidateTagAssignments RecruitmentCandidateTagAssignment[]
  workforceRecruitmentNovedades WorkforceRecruitmentNovedad[]
  workforceWorkplaceInboxItems WorkforceWorkplaceInbox[]
  workforceGoals              WorkforceGoal[]
  workforceGoalPeriods        WorkforceGoalPeriod[]
}

enum WorkforceRecruitmentNovedadEventType {
  STAGE_CHANGED
  HIRED
  REJECTED
}

enum OrgNotificationType {
  SHIFT_CHECK_IN
  SHIFT_CHECK_OUT
  TASK_COMPLETED
  TASK_OVERDUE
  GOAL_PERIOD_REPORTED
  PLATFORM_ANNOUNCEMENT
}

enum WorkforceWorkplaceInboxEventType {
  TASK_ASSIGNED
  GOAL_ASSIGNED
}

enum RemoteWorkSessionStatus {
  open
  completed
  admin_closed
}

enum WebSignal {
  connected
  background
  no_signal
}

enum SignalTelemetryStatus {
  no_data
  partial
  full
}

enum RemoteWorkEventType {
  CHECK_IN
  CHECK_OUT
  WEB_SIGNAL_CHANGED
  TAB_BACKGROUND
  TAB_VISIBLE
  ADMIN_CLOSE
  ADMIN_ADJUSTMENT
}

/// Colaborador con acceso al checador remoto (dominio separado de candidatos).
model WorkforceEmployee {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName        String
  employeeCode    String?
  position        String?
  department      String?
  timezone        String
  isActive        Boolean  @default(true)
  /// Minutos de jornada objetivo diaria; null o 0 = sin asistencia/checador.
  expectedWorkMinutes Int?
  accessTokenHash String   @unique
  tokenVersion    Int      @default(1)
  profilePhotoPath String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  sessions RemoteWorkSession[]
  events   RemoteWorkEvent[]
  tasks    WorkforceTask[]
  taskEventsActed WorkforceTaskEvent[] @relation("WorkforceTaskEventEmployee")
  documents WorkforceDocument[]
  orgNotifications OrgNotification[]
  recruitmentVacancyAssignees RecruitmentVacancyAssignee[]
  recruitmentCandidatesRegistered RecruitmentCandidate[] @relation("RecruitmentCandidateRegisteredBy")
  recruitmentCandidateNotesAuthored RecruitmentCandidateNote[] @relation("RecruitmentCandidateNoteWorkforceAuthor")
  recruitmentCandidateResumesUploaded RecruitmentCandidateResume[] @relation("RecruitmentCandidateResumeWorkforceUploader")
  workforceRecruitmentNovedadesReceived WorkforceRecruitmentNovedad[] @relation("WorkforceRecruitmentNovedadRecipient")
  workforceWorkplaceInboxReceived     WorkforceWorkplaceInbox[] @relation("WorkforceWorkplaceInboxRecipient")
  workforceGoals                      WorkforceGoal[]
  workforceGoalPeriods                WorkforceGoalPeriod[]

  @@index([organizationId])
  @@index([organizationId, isActive])
}

enum WorkforceDocumentCategory {
  CONTRATO
  IDENTIFICACION
  COMPROBANTE
  PRESTACIONES
  COTIZACION
  OTRO
}

model WorkforceDocument {
  id               String                    @id @default(cuid())
  organizationId   String
  organization     Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId       String
  employee         WorkforceEmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploadedBy       User                      @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  displayName      String
  category         WorkforceDocumentCategory @default(OTRO)
  filePath         String
  originalFileName String
  mimeType         String
  fileSize         Int
  createdAt        DateTime                  @default(now())

  @@index([organizationId, employeeId])
  @@index([organizationId])
}

enum WorkforceTaskStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
}

enum WorkforceTaskEventType {
  TASK_CREATED
  TASK_STATUS_CHANGED
  TASK_ARCHIVED
}

enum WorkforceTaskActorType {
  ADMIN
  EMPLOYEE
}

/// Actividad asignada a un colaborador (Kanban workforce).
model WorkforceTask {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        WorkforceEmployee   @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  title           String
  description     String?
  status          WorkforceTaskStatus   @default(PENDING)
  position        Int
  dueAt           DateTime?           @db.Timestamptz(6)
  createdByUserId String
  createdBy       User                @relation("WorkforceTaskCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  startedAt       DateTime?           @db.Timestamptz(6)
  completedAt     DateTime?           @db.Timestamptz(6)
  archivedAt      DateTime?           @db.Timestamptz(6)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  events WorkforceTaskEvent[]
  orgNotifications OrgNotification[]

  @@index([organizationId, employeeId])
  @@index([employeeId, status, position])
  @@index([employeeId, archivedAt])
}

model WorkforceTaskEvent {
  id              String                  @id @default(cuid())
  taskId          String
  task            WorkforceTask           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  type            WorkforceTaskEventType
  actorType       WorkforceTaskActorType
  actorUserId     String?
  actorUser       User?                   @relation("WorkforceTaskEventUser", fields: [actorUserId], references: [id], onDelete: SetNull)
  actorEmployeeId String?
  actorEmployee   WorkforceEmployee?      @relation("WorkforceTaskEventEmployee", fields: [actorEmployeeId], references: [id], onDelete: SetNull)
  fromStatus      WorkforceTaskStatus?
  toStatus        WorkforceTaskStatus?
  createdAt       DateTime                @default(now())

  @@index([taskId, createdAt])
}

enum WorkforceGoalType {
  COMPLIANCE
  QUANTITATIVE
}

enum WorkforceGoalPeriodicity {
  DAILY
  WEEKLY
  MONTHLY
}

enum WorkforceGoalBinaryResult {
  MET
  NOT_MET
}

/// Meta de resultado medible asignada a un colaborador (independiente de WorkforceTask).
model WorkforceGoal {
  id              String                   @id @default(cuid())
  organizationId  String
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employeeId      String
  employee        WorkforceEmployee        @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  createdByUserId String
  createdBy       User                     @relation("WorkforceGoalCreatedBy", fields: [createdByUserId], references: [id], onDelete: Restrict)
  title           String
  description     String?                  @db.Text
  goalType        WorkforceGoalType
  periodicity     WorkforceGoalPeriodicity
  targetValue     Float?
  unit            String?
  startDate       DateTime                 @db.Date
  endDate         DateTime?                @db.Date
  archivedAt      DateTime?                @db.Timestamptz(6)
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt

  periods           WorkforceGoalPeriod[]
  orgNotifications  OrgNotification[]

  @@index([organizationId, employeeId])
  @@index([employeeId, archivedAt])
  @@index([organizationId])
}

/// Registro de cumplimiento por periodo (snapshot de objetivo + resultado).
model WorkforceGoalPeriod {
  id                String                     @id @default(cuid())
  organizationId    String
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  goalId            String
  goal              WorkforceGoal              @relation(fields: [goalId], references: [id], onDelete: Cascade)
  employeeId        String
  employee          WorkforceEmployee          @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  periodStart       DateTime                   @db.Timestamptz(6)
  periodEnd         DateTime                   @db.Timestamptz(6)
  targetSnapshot    Float
  achievedValue     Float?
  binaryResult      WorkforceGoalBinaryResult?
  completionPercent Float?
  employeeComment   String?                    @db.Text
  submittedAt       DateTime?                  @db.Timestamptz(6)
  createdAt         DateTime                   @default(now())
  updatedAt         DateTime                   @updatedAt

  orgNotifications OrgNotification[]

  @@unique([goalId, periodStart])
  @@index([organizationId, employeeId])
  @@index([goalId, periodStart])
  @@index([organizationId, goalId])
}

model RemoteWorkSession {
  id                String                    @id @default(cuid())
  employeeId        String
  employee          WorkforceEmployee         @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  checkInAt         DateTime                  @db.Timestamptz(6)
  checkOutAt        DateTime?                 @db.Timestamptz(6)
  status            RemoteWorkSessionStatus   @default(open)
  lastHeartbeatAt   DateTime?                 @db.Timestamptz(6)
  lastWebSignal     WebSignal                 @default(no_signal)
  lastVisibilityState String?
  userAgent         String?
  clientMetadata    Json?
  anomalyFlag       Boolean                   @default(false)
  closedByUserId    String?
  closedBy          User?                     @relation("RemoteWorkSessionClosedBy", fields: [closedByUserId], references: [id], onDelete: SetNull)
  closedAt          DateTime?                 @db.Timestamptz(6)
  closeReason       String?
  adjustedByUserId  String?
  adjustedBy        User?                     @relation("RemoteWorkSessionAdjustedBy", fields: [adjustedByUserId], references: [id], onDelete: SetNull)
  adjustedAt        DateTime?                 @db.Timestamptz(6)
  adjustmentReason  String?
  /// Segundos acreditados con heartbeats válidos (acumulador).
  signalDurationSeconds Int                   @default(0)
  /// Inicio de ventana de telemetría (check-in o primer HB en sesión legacy).
  signalTrackingStartedAt DateTime?           @db.Timestamptz(6)
  /// Fin del último intervalo acreditado (ancla atómica anti-duplicado).
  signalLastCreditedAt DateTime?              @db.Timestamptz(6)
  signalSampleCount Int                       @default(0)
  signalTelemetryStatus SignalTelemetryStatus @default(no_data)
  createdAt         DateTime                  @default(now())
  updatedAt         DateTime                  @updatedAt

  events RemoteWorkEvent[]
  orgNotifications OrgNotification[]

  @@index([employeeId, checkInAt])
  @@index([employeeId, status])
}

model OrgNotification {
  id                  String              @id @default(cuid())
  organizationId      String
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  type                OrgNotificationType
  message             String
  employeeId          String?
  employee            WorkforceEmployee?  @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  taskId              String?
  task                WorkforceTask?      @relation(fields: [taskId], references: [id], onDelete: SetNull)
  remoteWorkSessionId String?
  remoteWorkSession   RemoteWorkSession?  @relation(fields: [remoteWorkSessionId], references: [id], onDelete: SetNull)
  goalId              String?
  goal                WorkforceGoal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  goalPeriodId        String?
  goalPeriod          WorkforceGoalPeriod? @relation(fields: [goalPeriodId], references: [id], onDelete: SetNull)
  dedupeKey           String
  createdAt           DateTime            @default(now())

  reads OrgNotificationRead[]

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, createdAt])
}

model OrgNotificationRead {
  notificationId String
  notification   OrgNotification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  readAt         DateTime        @default(now())

  @@id([notificationId, userId])
  @@index([userId])
}

model RemoteWorkEvent {
  id          String               @id @default(cuid())
  sessionId   String
  session     RemoteWorkSession    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  employeeId  String
  employee    WorkforceEmployee    @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  type        RemoteWorkEventType
  occurredAt  DateTime             @db.Timestamptz(6)
  payload     Json?
  actorUserId String?
  actorUser   User?                @relation("RemoteWorkEventActor", fields: [actorUserId], references: [id], onDelete: SetNull)
  createdAt   DateTime             @default(now())

  @@index([sessionId, occurredAt])
  @@index([employeeId, occurredAt])
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String
  fullName       String
  role           UserRole
  /// Créditos Aspen vinculados a este correo (admin que envía pruebas); consumo futuro al crear pruebas.
  adminCredits   Int       @default(0)
  /// Nota opcional visible solo para master_admin (seguimiento / gestión).
  adminNote      String?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  candidateProfile Candidate?
  assignmentsCreated Assignment[] @relation("AssignmentAssignedBy")
  remoteWorkSessionsClosed RemoteWorkSession[] @relation("RemoteWorkSessionClosedBy")
  remoteWorkSessionsAdjusted RemoteWorkSession[] @relation("RemoteWorkSessionAdjustedBy")
  remoteWorkEventsActed RemoteWorkEvent[] @relation("RemoteWorkEventActor")
  workforceTasksCreated WorkforceTask[] @relation("WorkforceTaskCreatedBy")
  workforceTaskEventsActed WorkforceTaskEvent[] @relation("WorkforceTaskEventUser")
  workforceGoalsCreated    WorkforceGoal[] @relation("WorkforceGoalCreatedBy")
  workforceDocumentsUploaded WorkforceDocument[]
  recruitmentVacancyDocumentsUploaded RecruitmentVacancyDocument[]
  recruitmentCandidateResumesUploaded RecruitmentCandidateResume[]
  orgNotificationReads       OrgNotificationRead[]
  recruitmentApplicationStageEvents RecruitmentApplicationStageEvent[] @relation("RecruitmentStageEventUser")
  recruitmentApplicationInterviewEventsAuthored RecruitmentApplicationInterviewEvent[] @relation("RecruitmentInterviewEventUser")
  recruitmentCandidateNotesAuthored RecruitmentCandidateNote[] @relation("RecruitmentCandidateNoteAuthor")
  recruitmentVacancyNotesAuthored RecruitmentVacancyNote[] @relation("RecruitmentVacancyNoteAuthor")
  recruitmentCandidateTagAssignmentsCreated RecruitmentCandidateTagAssignment[] @relation("RecruitmentCandidateTagAssignedBy")
}

model Candidate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String   @unique
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// CURP capturada al registrar la evaluación (opcional en registros previos a este campo).
  curp           String?
  createdAt      DateTime @default(now())

  assignments Assignment[]
}

/// Versioned instrument definition (JSON-driven motor)
model AssessmentDefinition {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  key            String
  name           String
  version        Int      @default(1)
  config         Json
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments Assignment[]

  @@unique([key, version])
}

model Assignment {
  id                     String             @id @default(cuid())
  candidateId            String
  candidate              Candidate          @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  assessmentDefinitionId String
  assessmentDefinition   AssessmentDefinition @relation(fields: [assessmentDefinitionId], references: [id], onDelete: Restrict)
  assignedByUserId       String?
  assignedBy             User?              @relation("AssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  /// Módulos elegidos en el alta (keys catálogo: honestidad, cleaver, …). Opcional en asignaciones antiguas.
  selectedModules        Json?
  /// Keys de módulos ya enviados por el candidato.
  completedModules       Json?
  /// Candado de facturación: true cuando ya se descontó el crédito por batería completada.
  creditDeducted         Boolean            @default(false)
  status                 AssignmentStatus   @default(pending)
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt

  attempts AssessmentAttempt[]
}

/// Módulo corporativo del catálogo (honestidad, cleaver, …) con banco de preguntas relacional.
model EvaluationModule {
  id          String     @id @default(cuid())
  key         String     @unique
  title       String
  description String?
  icon        String?
  sortOrder   Int        @default(0)
  isActive    Boolean    @default(true)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  questions Question[]
}

model Question {
  id        String       @id @default(cuid())
  moduleId  String
  module    EvaluationModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  type      QuestionType
  text      String
  /// Configuración flexible (instrucciones Cleaver, límites de audio, etc.).
  metadata  Json?
  sortOrder Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  options   QuestionOption[]
  responses CandidateResponse[]

  @@index([moduleId, sortOrder])
}

model QuestionOption {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  label      String
  /// Identificador estable para scoring / Cleaver (ej. palabra clave o dimensión DISC).
  value      String?
  /// Metadata por opción (ej. Cleaver: `{ "dimension": "D" | "I" | "S" | "C" }`).
  metadata   Json?
  sortOrder  Int      @default(0)

  responsesMore  CandidateResponse[] @relation("ResponseMoreOption")
  responsesLess  CandidateResponse[] @relation("ResponseLessOption")
  responsesChoice CandidateResponse[] @relation("ResponseSelectedOption")

  @@index([questionId, sortOrder])
}

model AssessmentAttempt {
  id             String        @id @default(cuid())
  assignmentId   String
  assignment     Assignment    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  /// Módulo UI iniciado (honestidad, cleaver, …).
  moduleKey      String?
  status         AttemptStatus @default(in_progress)
  startedAt      DateTime      @default(now())
  submittedAt    DateTime?
  timeLimitSec   Int?
  /// legacy JSON motor (honestidad demo) — convive con motor dinámico.
  responses      Json?
  /// Resultados adicionales por módulo (ej. audios Entrevista Digital).
  results        Json?
  scores         Json?
  interpretation Json?
  flags          Json?

  candidateResponses CandidateResponse[]

  @@index([assignmentId])
}

/// Respuesta granular por pregunta (motor dinámico).
model CandidateResponse {
  id               String   @id @default(cuid())
  attemptId        String
  attempt          AssessmentAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  questionId       String
  question         Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOptionId String?
  selectedOption   QuestionOption? @relation("ResponseSelectedOption", fields: [selectedOptionId], references: [id], onDelete: SetNull)
  moreOptionId     String?
  moreOption       QuestionOption? @relation("ResponseMoreOption", fields: [moreOptionId], references: [id], onDelete: SetNull)
  lessOptionId     String?
  lessOption       QuestionOption? @relation("ResponseLessOption", fields: [lessOptionId], references: [id], onDelete: SetNull)
  textValue        String?  @db.Text
  audioUrl         String?
  answeredAt       DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@unique([attemptId, questionId])
  @@index([attemptId])
}

enum RecruitmentVacancyStatus {
  ACTIVE
  PAUSED
  COVERED
  CLOSED
}

enum RecruitmentVacancyAssigneeRole {
  PRIMARY
  SUPPORT
}

/// Candidato de reclutamiento (dominio separado de evaluaciones psicométricas).
model RecruitmentCandidate {
  id             String    @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fullName          String
  profile           String
  profileOther      String?
  profileSecondary  String?
  phone             String
  whatsapp          String?
  email             String?
  city              String?
  state             String?
  locality          String?
  neighborhood      String?
  source            String?
  sourceOther       String?
  notes             String?   @db.Text
  registeredByWorkforceEmployeeId String?
  registeredByWorkforceEmployee   WorkforceEmployee? @relation("RecruitmentCandidateRegisteredBy", fields: [registeredByWorkforceEmployeeId], references: [id], onDelete: SetNull)
  archivedAt     DateTime? @db.Timestamptz(6)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  applications RecruitmentApplication[]
  resume       RecruitmentCandidateResume?
  notesRows    RecruitmentCandidateNote[]
  tagAssignments RecruitmentCandidateTagAssignment[]
  workforceRecruitmentNovedades WorkforceRecruitmentNovedad[]

  @@index([organizationId])
  @@index([organizationId, fullName])
  @@index([organizationId, email])
  @@index([organizationId, phone])
  @@index([organizationId, archivedAt])
  @@index([organizationId, profile])
  @@index([organizationId, source])
  @@index([organizationId, createdAt])
  @@index([registeredByWorkforceEmployeeId])
}

model RecruitmentCandidateNote {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  authorUserId   String?
  author         User?                @relation("RecruitmentCandidateNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  authorWorkforceEmployeeId String?
  authorWorkforceEmployee   WorkforceEmployee? @relation("RecruitmentCandidateNoteWorkforceAuthor", fields: [authorWorkforceEmployeeId], references: [id], onDelete: SetNull)
  body           String               @db.Text
  legacyImport   Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  editedAt       DateTime?            @db.Timestamptz(6)
  deletedAt      DateTime?            @db.Timestamptz(6)

  @@index([organizationId, candidateId])
  @@index([candidateId, createdAt])
  @@index([organizationId, candidateId, deletedAt])
  @@index([authorWorkforceEmployeeId])
}

model RecruitmentVacancyNote {
  id             String               @id @default(cuid())
  organizationId String
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vacancyId      String
  vacancy        RecruitmentVacancy   @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  authorUserId   String?
  author         User?                @relation("RecruitmentVacancyNoteAuthor", fields: [authorUserId], references: [id], onDelete: SetNull)
  body           String               @db.Text
  legacyImport   Boolean              @default(false)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  editedAt       DateTime?            @db.Timestamptz(6)
  deletedAt      DateTime?            @db.Timestamptz(6)

  @@index([organizationId, vacancyId])
  @@index([vacancyId, createdAt])
  @@index([organizationId, vacancyId, deletedAt])
}

model RecruitmentCandidateTag {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  colorKey       String
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  assignments RecruitmentCandidateTagAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId, isActive])
}

model RecruitmentCandidateTagAssignment {
  id              String               @id @default(cuid())
  organizationId  String
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId     String
  candidate       RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  tagId           String
  tag             RecruitmentCandidateTag @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdByUserId String?
  createdBy       User?                @relation("RecruitmentCandidateTagAssignedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime             @default(now())

  @@unique([candidateId, tagId])
  @@index([organizationId, candidateId])
  @@index([organizationId, tagId])
}

/// CV actual del candidato (un archivo por candidato en V1).
model RecruitmentCandidateResume {
  id               String               @id @default(cuid())
  organizationId   String
  organization     Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId      String               @unique
  candidate        RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  uploadedByUserId String?
  uploadedBy       User?                @relation(fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  uploadedByWorkforceEmployeeId String?
  uploadedByWorkforceEmployee     WorkforceEmployee? @relation("RecruitmentCandidateResumeWorkforceUploader", fields: [uploadedByWorkforceEmployeeId], references: [id], onDelete: SetNull)
  filePath         String
  originalFileName String
  mimeType         String
  fileSize         Int
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  @@index([organizationId])
  @@index([organizationId, candidateId])
}

enum RecruitmentVacancyDocumentCategory {
  PROFILE
  ROUTES
  FORM
  COMMERCIAL_PROPOSAL
  CLIENT_DOCUMENT
  OTHER
}

model RecruitmentVacancy {
  id                  String                   @id @default(cuid())
  organizationId      String
  organization        Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title               String
  clientName          String
  location            String?
  positionsTotal      Int
  openedAt            DateTime                 @db.Timestamptz(6)
  targetCoverageDate  DateTime?                @db.Date
  status              RecruitmentVacancyStatus @default(ACTIVE)
  jobDescription      String?                  @db.Text
  notes               String?                  @db.Text
  createdAt           DateTime                 @default(now())
  updatedAt           DateTime                 @updatedAt

  applications RecruitmentApplication[]
  assignees    RecruitmentVacancyAssignee[]
  documents    RecruitmentVacancyDocument[]
  vacancyStages RecruitmentVacancyStage[]
  notesRows    RecruitmentVacancyNote[]
  workforceRecruitmentNovedades WorkforceRecruitmentNovedad[]

  @@index([organizationId])
  @@index([organizationId, status])
  @@index([organizationId, openedAt])
}

/// Funnel de etapas habilitadas y ordenadas por vacante.
model RecruitmentVacancyStage {
  id             String             @id @default(cuid())
  organizationId String
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vacancyId      String
  vacancy        RecruitmentVacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  stageId        String
  stage          RecruitmentStage   @relation(fields: [stageId], references: [id], onDelete: Restrict)
  position       Int
  isEnabled      Boolean            @default(true)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  @@unique([vacancyId, stageId])
  @@index([organizationId])
  @@index([vacancyId])
  @@index([organizationId, vacancyId])
  @@index([stageId])
  @@index([vacancyId, isEnabled])
  @@index([vacancyId, position])
}

model RecruitmentVacancyDocument {
  id               String                             @id @default(cuid())
  organizationId   String
  organization     Organization                       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vacancyId        String
  vacancy          RecruitmentVacancy                 @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  uploadedByUserId String
  uploadedBy       User                               @relation(fields: [uploadedByUserId], references: [id], onDelete: Restrict)
  displayName      String
  category         RecruitmentVacancyDocumentCategory @default(OTHER)
  filePath         String
  originalFileName String
  mimeType         String
  fileSize         Int
  createdAt        DateTime                           @default(now())

  @@index([organizationId, vacancyId])
  @@index([organizationId])
  @@index([vacancyId])
}

model RecruitmentVacancyAssignee {
  id             String                         @id @default(cuid())
  organizationId String
  organization   Organization                   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vacancyId      String
  vacancy        RecruitmentVacancy             @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  employeeId     String
  employee       WorkforceEmployee              @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  role           RecruitmentVacancyAssigneeRole
  createdAt      DateTime                       @default(now())

  @@unique([vacancyId, employeeId])
  @@index([organizationId])
  @@index([vacancyId])
  @@index([organizationId, vacancyId])
}

/// Etapa configurable del pipeline por organización.
model RecruitmentStage {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  name           String
  position       Int
  isTerminal     Boolean  @default(false)
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  applicationsAtStage RecruitmentApplication[]
  vacancyStages       RecruitmentVacancyStage[]
  stageEventsFrom     RecruitmentApplicationStageEvent[] @relation("RecruitmentStageEventFrom")
  stageEventsTo       RecruitmentApplicationStageEvent[] @relation("RecruitmentStageEventTo")
  interviewEvents     RecruitmentApplicationInterviewEvent[]
  workforceRecruitmentNovedadesFrom WorkforceRecruitmentNovedad[] @relation("WorkforceRecruitmentNovedadFromStage")
  workforceRecruitmentNovedadesTo   WorkforceRecruitmentNovedad[] @relation("WorkforceRecruitmentNovedadToStage")

  @@unique([organizationId, key])
  @@index([organizationId, position])
  @@index([organizationId, isActive])
}

/// Postulación: candidato + vacante + proceso en una etapa.
model RecruitmentApplication {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId    String
  candidate      RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  vacancyId      String
  vacancy        RecruitmentVacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  stageId        String
  stage          RecruitmentStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  position       Int
  appliedAt      DateTime @db.Timestamptz(6)
  interviewScheduledAt DateTime? @db.Timestamptz(6)
  /// false = solo fecha conocida (no mostrar hora en UI).
  interviewTimeSpecified Boolean @default(true)
  notes          String?  @db.Text
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  stageEvents RecruitmentApplicationStageEvent[]
  interviewEvents RecruitmentApplicationInterviewEvent[]
  workforceRecruitmentNovedades WorkforceRecruitmentNovedad[]

  @@unique([candidateId, vacancyId])
  @@index([organizationId])
  @@index([organizationId, vacancyId])
  @@index([organizationId, stageId])
  @@index([vacancyId, stageId, position])
  @@index([organizationId, candidateId])
}

enum RecruitmentApplicationInterviewEventType {
  ATTENDED
  NO_SHOW
  RESCHEDULED
}

/// Resultado histórico de una cita de entrevista (snapshot; no reemplaza stage history).
model RecruitmentApplicationInterviewEvent {
  id                         String   @id @default(cuid())
  organizationId             String
  organization               Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId              String
  application                RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  stageId                    String
  stage                      RecruitmentStage @relation(fields: [stageId], references: [id], onDelete: Restrict)
  eventType                  RecruitmentApplicationInterviewEventType
  scheduledAt                DateTime @db.Timestamptz(6)
  scheduledTimeSpecified     Boolean  @default(true)
  rescheduledToAt            DateTime? @db.Timestamptz(6)
  rescheduledToTimeSpecified Boolean?
  createdByUserId            String
  createdBy                  User @relation("RecruitmentInterviewEventUser", fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt                  DateTime @default(now())

  @@index([applicationId, createdAt])
  @@index([organizationId])
  @@index([organizationId, applicationId])
}

model RecruitmentApplicationStageEvent {
  id              String   @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  applicationId   String
  application     RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStageId     String?
  fromStage       RecruitmentStage? @relation("RecruitmentStageEventFrom", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStageId       String
  toStage         RecruitmentStage @relation("RecruitmentStageEventTo", fields: [toStageId], references: [id], onDelete: Restrict)
  changedByUserId String?
  changedBy       User? @relation("RecruitmentStageEventUser", fields: [changedByUserId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())

  @@index([applicationId, createdAt])
  @@index([organizationId])
}

/// Novedad de reclutamiento para el colaborador que registró al candidato (portal checador).
model WorkforceRecruitmentNovedad {
  id                            String   @id @default(cuid())
  organizationId                String
  organization                  Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientWorkforceEmployeeId  String
  recipientWorkforceEmployee    WorkforceEmployee @relation("WorkforceRecruitmentNovedadRecipient", fields: [recipientWorkforceEmployeeId], references: [id], onDelete: Cascade)
  candidateId                   String
  candidate                     RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  applicationId                 String
  application                   RecruitmentApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  vacancyId                     String
  vacancy                       RecruitmentVacancy @relation(fields: [vacancyId], references: [id], onDelete: Cascade)
  eventType                     WorkforceRecruitmentNovedadEventType
  fromStageId                   String?
  fromStage                     RecruitmentStage? @relation("WorkforceRecruitmentNovedadFromStage", fields: [fromStageId], references: [id], onDelete: SetNull)
  toStageId                     String
  toStage                       RecruitmentStage @relation("WorkforceRecruitmentNovedadToStage", fields: [toStageId], references: [id], onDelete: Restrict)
  message                       String
  metadata                      Json
  dedupeKey                     String
  createdAt                     DateTime @default(now())
  readAt                        DateTime? @db.Timestamptz(6)

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, recipientWorkforceEmployeeId, createdAt], map: "WrNovedad_org_recipient_created")
  @@index([organizationId, recipientWorkforceEmployeeId, readAt], map: "WrNovedad_org_recipient_readAt")
}

/// Inbox laboral del colaborador (actividades, metas; distinto de reclutamiento).
model WorkforceWorkplaceInbox {
  id                           String                           @id @default(cuid())
  organizationId               String
  organization                 Organization                     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recipientWorkforceEmployeeId String
  recipientWorkforceEmployee   WorkforceEmployee                @relation("WorkforceWorkplaceInboxRecipient", fields: [recipientWorkforceEmployeeId], references: [id], onDelete: Cascade)
  eventType                    WorkforceWorkplaceInboxEventType
  message                      String
  metadata                     Json
  dedupeKey                    String
  readAt                       DateTime?                        @db.Timestamptz(6)
  createdAt                    DateTime                         @default(now())

  @@unique([organizationId, dedupeKey])
  @@index([organizationId, recipientWorkforceEmployeeId, createdAt], map: "WwInbox_org_recipient_created")
  @@index([organizationId, recipientWorkforceEmployeeId, readAt], map: "WwInbox_org_recipient_readAt")
}
